{
  "name": "shorts-9x16",
  "version": "0.1.0",
  "description": "9:16 세로 쇼츠 캔버스 + 자막 슬롯 기본 템플릿. 1080x1920, 자막 하단 1/3.",
  "scope": "layout",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background_color": "#000000"
  },
  "video_layer": {
    "fit_mode": "crop_center",
    "scale_factor": 1.0,
    "comment": "원본이 16:9면 좌우 잘림. center 크롭. 화자 위치가 어긋나면 manual_offset 사용."
  },
  "caption_slot": {
    "anchor": "bottom-center",
    "y_offset_pct": 0.22,
    "max_width_pct": 0.85,
    "default_style": {
      "font": {
        "ko": "Pretendard Black",
        "en": "Geist Black",
        "ja": "NotoSansJP Bold",
        "zh": "NotoSansSC Bold"
      },
      "size_pt": 56,
      "color": "#FFEB3B",
      "outline": {
        "width_px": 4,
        "color": "#000000"
      },
      "background_box": {
        "enabled": false,
        "color": "#000000AA",
        "padding_px": 12
      },
      "line_height": 1.2,
      "weight": "bold"
    }
  },
  "safe_zones": {
    "top_pct": 0.08,
    "bottom_pct": 0.12,
    "comment": "유튜브 쇼츠 UI(상단 채널명, 하단 컨트롤) 가림 방지"
  },
  "audio_normalize": {
    "enabled": true,
    "target_lufs": -14,
    "comment": "유튜브 쇼츠 권장 라우드니스"
  },
  "watermark_slot": {
    "enabled": false
  }
}
