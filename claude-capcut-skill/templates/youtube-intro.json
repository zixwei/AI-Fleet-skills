{
  "name": "youtube-intro",
  "version": "0.1.0",
  "description": "유튜브 영상 인트로 자막 스타일 (제목 + 부제목 + 채널명). 1920x1080.",
  "scope": "intro",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "duration_sec": 5,
  "background": {
    "type": "video_passthrough",
    "fallback_color": "#0F172A"
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "content": "[제목]",
      "anchor": "center",
      "y_offset_pct": -0.05,
      "style": {
        "font": {
          "ko": "Pretendard Black",
          "en": "Geist Black"
        },
        "size_pt": 96,
        "color": "#FFFFFF",
        "outline": { "width_px": 0 },
        "shadow": {
          "enabled": true,
          "offset_x_px": 0,
          "offset_y_px": 4,
          "blur_px": 12,
          "color": "#00000088"
        }
      },
      "animation": {
        "in": { "type": "fade-up", "duration_ms": 600 },
        "out": { "type": "fade", "duration_ms": 400 }
      }
    },
    {
      "id": "subtitle",
      "type": "text",
      "content": "[부제목]",
      "anchor": "center",
      "y_offset_pct": 0.08,
      "style": {
        "font": {
          "ko": "Pretendard Medium",
          "en": "Geist Regular"
        },
        "size_pt": 36,
        "color": "#D4D4D8",
        "weight": "medium"
      },
      "animation": {
        "in": { "type": "fade-up", "duration_ms": 600, "delay_ms": 200 },
        "out": { "type": "fade", "duration_ms": 400 }
      }
    },
    {
      "id": "channel-name",
      "type": "text",
      "content": "[채널명]",
      "anchor": "bottom-left",
      "x_offset_px": 60,
      "y_offset_px": -60,
      "style": {
        "font": {
          "ko": "Pretendard SemiBold",
          "en": "JetBrains Mono"
        },
        "size_pt": 24,
        "color": "#A1A1AA",
        "weight": "semibold"
      },
      "animation": {
        "in": { "type": "fade", "duration_ms": 400, "delay_ms": 400 }
      }
    }
  ],
  "audio_normalize": {
    "enabled": true,
    "target_lufs": -16
  }
}
